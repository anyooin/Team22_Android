<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 검색창 -->
    <TextView
        android:id="@+id/search_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/gray_500"
        android:padding="8dp"
        android:text="검색어를 입력해 주세요."
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--    &lt;!&ndash; 검색 취소 버튼 &ndash;&gt;-->
    <!--    <ImageView-->
    <!--        android:id="@+id/cancel_button"-->
    <!--        android:layout_width="wrap_content"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:src="@drawable/all_icon_cancel"-->
    <!--        app:layout_constraintEnd_toEndOf="parent"-->
    <!--        app:layout_constraintTop_toTopOf="@+id/search_edit_text"-->
    <!--        app:layout_constraintBottom_toBottomOf="@+id/search_edit_text"-->
    <!--        android:layout_marginEnd="16dp" />-->

    <!-- 검색 이미지 -->
    <ImageView
        android:id="@+id/search_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:src="@drawable/all_icon_search"
        app:layout_constraintBottom_toBottomOf="@+id/search_edit_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/search_edit_text" />

    <View
        android:id="@+id/split_line1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/gray_500"
        app:layout_constraintStart_toStartOf="@id/search_edit_text"
        app:layout_constraintTop_toBottomOf="@id/search_edit_text"
        app:layout_constraintEnd_toEndOf="@+id/search_icon"/>


    <!-- 새로운 친구 텍스트 -->
    <TextView
        android:id="@+id/new_friends_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/new_friend"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/split_line1" />

    <!-- 새로운 친구 목록 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/new_friends_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        app:layout_constraintTop_toBottomOf="@+id/new_friends_text" />

    <!-- 대기 중인 친구 섹션 -->
    <LinearLayout
        android:id="@+id/pending_friends_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/new_friends_recycler_view"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="5dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pending_friends_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" >

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/all_icon_spinner"
                app:layout_constraintTop_toTopOf="@+id/pending_friends_header"
                app:layout_constraintBottom_toBottomOf="@+id/pending_friends_header"
                app:layout_constraintStart_toEndOf="@+id/pending_friends_header"/>

            <!-- 대기 중인 친구 텍스트 (클릭 시 확장/축소) -->
            <TextView
                android:id="@+id/pending_friends_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pending_friend_open"
                android:textStyle="bold"
                android:textSize="16sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 대기 중인 친구 목록 RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pending_friends_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="8dp"
            app:layout_constraintTop_toBottomOf="@+id/pending_friends_header"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- 내 친구 목록 텍스트 -->
    <TextView
        android:id="@+id/friends_list_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="my_friend_with_count"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pending_friends_section" />

    <!-- 내 친구 목록 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/my_friends_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        app:layout_constraintTop_toBottomOf="@+id/friends_list_title"
        tools:listitem="@layout/friend_item_basic" />

</androidx.constraintlayout.widget.ConstraintLayout>
