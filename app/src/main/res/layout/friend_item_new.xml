<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="4dp"
    android:paddingVertical="8dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/profile_cardview"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="10dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toStartOf="@id/user_name_textview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/profile_initial_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/share_friend_image"
            android:scaleType="centerCrop"
            android:src="@drawable/stalker" />

        <TextView
            android:id="@+id/profile_initial_textview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/yellow_500"
            android:gravity="center"
            android:text="@string/profile_name"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="invisible" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/user_name_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/user_name"
        android:textColor="@color/black"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/profile_cardview"
        app:layout_constraintTop_toTopOf="@id/profile_cardview" />

    <TextView
        android:id="@+id/user_id_textview"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:maxWidth="100dp"
        android:maxLines="1"
        android:text="@string/user_id"
        android:textColor="@color/gray_500"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/profile_cardview"
        app:layout_constraintStart_toEndOf="@id/profile_cardview"
        app:layout_constraintTop_toBottomOf="@id/user_name_textview" />

    <Button
        style="@style/friendButton"
        android:id="@+id/friend_accept_button"
        android:layout_marginEnd="8dp"
        android:text="@string/accept_request"
        app:layout_constraintBottom_toBottomOf="@id/profile_cardview"
        app:layout_constraintEnd_toStartOf="@id/friend_decline_button"
        app:layout_constraintTop_toTopOf="@id/profile_cardview" />

    <Button
        style="@style/friendButton"
        android:id="@+id/friend_decline_button"
        android:layout_marginEnd="8dp"
        android:text="@string/reject_request"
        app:layout_constraintBottom_toBottomOf="@id/profile_cardview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/profile_cardview" />

</androidx.constraintlayout.widget.ConstraintLayout>
