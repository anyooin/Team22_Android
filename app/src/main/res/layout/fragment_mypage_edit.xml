<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="@dimen/padding_normal">

    <!-- 프로필 이미지 - CardView로 감쌈 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/profile_cardview"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:cardCornerRadius="75dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/profile_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/share_album_image"
            android:scaleType="centerCrop"
            android:src="@drawable/all_profile_placeholder" />
    </androidx.cardview.widget.CardView>

    <!-- 한줄 소개 수정 -->

    <!-- 카테고리 설정 -->

    <!-- GridLayout 추가 -->

    <!--저장-->


    <EditText
        android:id="@+id/profile_name_edit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="닉네임을 수정하세요."
        android:text="닉네임"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_cardview" />

    <EditText
        android:id="@+id/profile_intro_edit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="92dp"
        android:hint="@string/signup_introduce_hint"
        android:text="@string/mypage_introduce"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_cardview" />

    <Button
        android:id="@+id/button_rock"
        style="@style/CategoryButton"
        android:layout_marginTop="104dp"
        android:text="@string/category_rock"
        app:layout_constraintEnd_toStartOf="@id/button_pop"
        app:layout_constraintStart_toEndOf="@id/button_hiphop"
        app:layout_constraintTop_toBottomOf="@id/category_title" />

    <Button
        android:id="@+id/button_hiphop"
        style="@style/CategoryButton"
        android:layout_marginTop="104dp"
        android:text="@string/category_hiphop"
        app:layout_constraintEnd_toStartOf="@id/button_rock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/category_title" />

    <Button
        android:id="@+id/button_dance"
        style="@style/CategoryButton"
        android:layout_marginTop="12dp"
        android:text="@string/category_dance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/button_ballad"
        app:layout_constraintTop_toBottomOf="@id/button_pop" />

    <Button
        android:id="@+id/button_pop"
        style="@style/CategoryButton"
        android:layout_marginTop="104dp"
        android:text="@string/category_pop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/button_rock"
        app:layout_constraintTop_toBottomOf="@id/category_title" />

    <Button
        android:id="@+id/button_jpop"
        style="@style/CategoryButton"
        android:layout_marginTop="16dp"
        android:text="@string/category_jpop"
        app:layout_constraintEnd_toStartOf="@id/button_ballad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_hiphop" />

    <Button
        android:id="@+id/button_ballad"
        style="@style/CategoryButton"
        android:layout_marginTop="4dp"
        android:text="@string/category_ballad"
        app:layout_constraintEnd_toStartOf="@id/button_dance"
        app:layout_constraintStart_toEndOf="@id/button_jpop"
        app:layout_constraintTop_toBottomOf="@id/button_rock" />


    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/category_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:columnCount="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/category_title">

        <!-- 카테고리 버튼들 -->

    </androidx.gridlayout.widget.GridLayout>

    <TextView
        android:id="@+id/category_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/mypage_category_setting"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_intro_edit" />

    <Button
        android:id="@+id/save_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/yellow_300"
        android:text="저장하기"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/category_grid"
        app:layout_constraintVertical_bias="0.845" />
</androidx.constraintlayout.widget.ConstraintLayout>